{%- set spgCourse = "crossfit" -%}{%- set spgTitle = "" -%}{%- set spgHint = "" -%}{%- set spgEager = false -%}
{% include "partials/schedule-section.njk" %}

{#- ============ Tarifs ============ -#}
{%- set priceHighlight = "unlimited" -%}{%- set priceTag = "Notre conseil" -%}{%- set priceCourse = "crossfit" -%}
{%- set priceTitle = "" -%}
{%- set priceLead = "Une seule grille pour tous les cours adultes. Dès 3 WOD par semaine, l'Unlimited revient moins cher à la séance." -%}
{% include "partials/prices.njk" %}

{% set reviewsFlush = true %}{% include "partials/reviews.njk" %}

{#- ============ FAQ ============ -#}
{%- set faqTitle = "Avant ton <span class=\"acc\">premier WOD</span>" -%}
{%- set faqLead = "" -%}{%- set faqFlush = false -%}
{%- set faqItems = [
  { q: "Je ne suis pas assez en forme pour le CrossFit.", a: "<p>C'est justement pour ça que le cours est encadré. Chaque mouvement a une version plus simple, chaque charge s'adapte, et le coach est à côté de toi pendant toute la séance.</p><p>Personne ne te compare aux autres. La forme vient en venant.</p>" },
  { q: "Je ne connais aucun mouvement, c'est un problème ?", a: "<p>Non. Chaque séance commence par une partie technique où le coach décompose les mouvements du jour. Tu les apprends avant de les mettre dans le WOD.</p>" },
  { q: "Combien de fois par semaine venir ?", a: "<p>Deux séances par semaine suffisent pour progresser et prendre le rythme, c'est la formule Easy Peasy à 79 € par mois. Si tu viens trois fois ou plus, l'Unlimited à 115 € par mois revient moins cher à la séance.</p>" },
  { q: "Quelle différence entre un WOD et le Free Access ?", a: "<p>Le WOD est un cours encadré par un coach, avec un programme et un groupe. Le Free Access est un créneau libre pour t'entraîner seul, inclus dans les formules adultes sous conditions de bonne pratique et de sécurité.</p>" },
  { q: "Qu'est-ce que je dois apporter ?", a: "<p>Une tenue dans laquelle tu bouges bien, des baskets propres et une gourde. Le matériel, on l'a. On a des vestiaires femmes et hommes, avec des douches pour après ton cours.</p>" }
] -%}
{% include "partials/faq.njk" %}

{% set currentCourse = "crossfit" %}{% include "partials/next-courses.njk" %}

{% set finalTitle = "Ton premier WOD t'attend" %}{% set finalText = "Séance d'essai gratuite et sans engagement. Choisis un créneau CrossFit, un coach t'accueille et adapte tout à ton niveau." %}
{% include "partials/final-cta.njk" %}
