<section class="sec" aria-labelledby="t-olymp" style="background:var(--bg-alt)">
  <div class="wrap">
    <div class="split">
      <div class="slot">{% slot { slot: "ph-un-membre-en-reception-d-arrache-barre-au-dessus", alt: "Un membre en réception d'arraché, barre au-dessus de la tête, le coach à côté qui observe", label: "Photo 1", widths: [480, 960], sizes: "(min-width: 961px) 45vw, 90vw" } %}</div>
