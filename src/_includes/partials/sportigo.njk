{#- Cadre du widget Sportigo (un seul par page). Le script Sportigo et initComponent sont chargés par main.js
    avec les mêmes paramètres que le code d'intégration : initComponent("Appointment", "sportigo-planning", <id>, {colored: true, readonly: false, activities, fromDate}).
    Variables : spgCourse (clé du cours, filtre le planning), spgTitle, spgHint, spgEager -#}
<div class="spg" data-sportigo data-widget-id="{{ site.sportigoWidgetId }}"{% if spgCourse %} data-activities="{{ horaires.sportigo[spgCourse] | json | esc }}" data-slots="{{ spgCourse | planningJours(horaires) | esc }}"{% endif %}{% if spgEager %} data-eager{% endif %}>
  <div class="spg-head"><h3 class="disp h3">{{ spgTitle or "Réserve ton créneau" }}</h3><p class="spg-hint">{% icon "mouse-pointer-click", 18, "ic-acc" %}{{ spgHint or "Clique sur un créneau pour réserver." }}</p></div>
  <div class="spg-box">
    <div class="spg-ph"><span class="slot-tag">Planning Sportigo</span><span>Le planning et la réservation s'affichent ici.</span></div>
    <div id="sportigo-planning"></div>
  </div>
  <p class="spg-legal">Tes coordonnées servent uniquement à organiser ta séance. <a href="/politique-de-confidentialite/">Politique de confidentialité</a></p>
</div>
<script>
// Écouteur des événements du widget Sportigo vers le dataLayer (sportigo.click, sportigo.formSubmit, sportigo.custom)
  document.addEventListener('shadowDomClick', function(event) {
    const clickData = event.detail;
    if (window.dataLayer) {
      window.dataLayer.push({
        'event': 'sportigo.click',
        'element_tag': clickData.tagName,
        'element_id': clickData.id,
        'element_class': clickData.className,
        'element_text': clickData.textContent,
        'element_href': clickData.href,
        'element_path': clickData.elementPath,
        'click_timestamp': clickData.timestamp,
        'click_x': clickData.clientX,
        'click_y': clickData.clientY,
        'element_dataset': clickData.dataset
      });
    }
  });
  document.addEventListener('sportigoFormSubmit', function(event) {
    const formData = event.detail;
    if (window.dataLayer) {
      window.dataLayer.push({
        'event': 'sportigo.formSubmit',
        'form_type': formData.formType,
        'form_action': formData.formAction,
        'form_data': formData.formData,
        'form_timestamp': formData.timestamp
      });
    }
  });
  document.addEventListener('sportigoCustomEvent', function(event) {
    const eventData = event.detail;
    if (window.dataLayer) {
      window.dataLayer.push({
        'event': 'sportigo.custom',
        'custom_event_type': eventData.eventType,
        'custom_event_data': eventData.eventData,
        'custom_timestamp': eventData.timestamp
      });
    }
  });
</script>
