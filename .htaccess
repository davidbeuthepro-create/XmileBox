# SITE_ENV=test : le site ne doit pas être indexé
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

# CrossFit Xmile : crossfitxmile.com
# Hébergement Hostinger (LiteSpeed, compatible Apache).
# Pages en dossiers : /crossfit-woluwe/index.html sert l'URL /crossfit-woluwe/

Options -Indexes -MultiViews
DirectoryIndex index.html index.php
DirectorySlash On
ErrorDocument 404 /404.html

RewriteEngine On

# ---------------------------------------------------------------
# 1. Une seule version du site : https, sans www (une seule redirection)
# ---------------------------------------------------------------
RewriteCond %{HTTP_HOST} ^(www\.)?crossfitxmile\.com$ [NC]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://crossfitxmile.com%{REQUEST_URI} [L,R=301,NE]

# ---------------------------------------------------------------
# 2. Jamais de /index.html visible dans l'URL
# ---------------------------------------------------------------
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [L,R=301]

# ---------------------------------------------------------------
# 3. Fichiers internes jamais exposés (le dépôt Git est déployé tel quel)
# ---------------------------------------------------------------
RedirectMatch 404 /\.(git|github|env|vscode)(/|$)
RedirectMatch 404 ^/_migration(/|$)
<FilesMatch "\.(md|lock|log|sh|ini|yml|yaml)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ---------------------------------------------------------------
# 4. Anciennes URLs techniques WordPress
#    Les 15 pages publiques gardent exactement leur URL : rien à rediriger.
# ---------------------------------------------------------------
RewriteRule ^sitemap_index\.xml$ /sitemap.xml [L,R=301]
RewriteRule ^page-sitemap\.xml$ /sitemap.xml [L,R=301]
RewriteRule ^(.*/)?feed/?$ - [G,L]
RewriteRule ^comments/feed/?$ - [G,L]
RewriteRule ^(wp-admin|wp-includes|wp-json)(/.*)?$ - [G,L]
RewriteRule ^(wp-login|xmlrpc|wp-cron)\.php$ - [G,L]
RewriteRule ^wp-content/ - [G,L]
RewriteRule ^imunify-bot-check/?$ - [G,L]

# Liens courts WordPress (?p=123, ?page_id=123) vers l'accueil
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=[0-9]+(&|$) [NC]
RewriteRule ^$ /? [L,R=301]

# ---------------------------------------------------------------
# 5. Anciens boutons « essai » et « drop-in » (?subject=...) vers la page Séance d'essai
#    Ces liens traînent dans les bios, fiches et anciens posts.
# ---------------------------------------------------------------
RewriteCond %{QUERY_STRING} (^|&)subject=(essai|drop-in)(&|$) [NC]
RewriteRule ^ /seance-essai/? [L,R=301]

# ---------------------------------------------------------------
# 6. Performance : compression et cache navigateur
# ---------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  # CSS et JS : 1 an à condition que les noms de fichiers soient versionnés (style.a1b2c3.css)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

# ---------------------------------------------------------------
# 7. En-têtes de sécurité de base
# ---------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # À activer seulement une fois le https vérifié sur tout le domaine :
  # Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
